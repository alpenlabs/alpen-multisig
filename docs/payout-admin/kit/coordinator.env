# Bash environment for this regtest coordinator only; loaded by run-coordinator.sh.
# SERVER_HOST exposes the coordinator to testers. Firewall 3000 to the trusted LAN/VPN.
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
AUTH_CHALLENGE_TTL_MS=120000
AUTH_SESSION_TTL_MS=86400000
PROPOSAL_EXPIRY_DAYS=7
BITCOIN_NETWORK=regtest
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=user
BITCOIN_RPC_PASS=password
# Relative paths are resolved from this file's directory by the launcher.
PAYOUT_ADMIN_PARAMS_PATH=./seed/params.toml
# Config accepts this URL; payout flows need no ASM service at this address.
# mock:// is rejected in the normal release build.
STRATA_ADMIN_STATE_RPC_URL=http://127.0.0.1:8080
ORCHESTRATOR_PROFILE=development
# In-memory storage: unset, NOT an empty DATABASE_URL. Restart loses sessions and payouts.
# To use Postgres, replace the unset with DATABASE_URL='postgres://...' locally.
# production profile requires DATABASE_URL. Never commit a database credential.
unset DATABASE_URL
# Logging read by tracing_subscriber in main.rs.
RUST_LOG=info
